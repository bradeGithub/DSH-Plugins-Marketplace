    // ===== 列表消费纯函数（无 React/fetch/DOM 依赖，可被单测直接 eval）=====
    // 刷新指纹：与当前已展示内容一致时跳过重渲染。
    // 服务端内容指纹（fp，full_name 序列哈希）优先——cached_at 每次 refresh 都变，用它门控会永远不跳过；
    // 旧版服务端无 fp 时回退 source+cached_at+total（= 每次重渲染的旧行为）：只按 source+total 门控
    // 会在「内容一进一出」时错误跳过 → 列表漏更新，安全侧宁可比对新值。
    function fingerprintOf(data) {
      if (typeof data.fp === "string") return data.fp;
      return JSON.stringify([data.source || "", data.cached_at || "", data.total || 0]);
    }
    // S2 字段加权匹配分（镜像 lib/domain/list.js 语义，ES5 无依赖）：
    // name=8 / full_name=4 / topics=2 / description=1，命中字段累加；不命中返回 0。
    function repoMatchScore(r, query) {
      var q = String(query || "").trim().toLowerCase();
      if (!q || !r) return 0;
      var score = 0;
      if (String(r.name || "").toLowerCase().indexOf(q) !== -1) score += 8;
      if (String(r.full_name || "").toLowerCase().indexOf(q) !== -1) score += 4;
      var topics = r.topics || [];
      for (var i = 0; i < topics.length; i++) {
        if (String(topics[i]).toLowerCase().indexOf(q) !== -1) { score += 2; break; }
      }
      if (String(r.description || "").toLowerCase().indexOf(q) !== -1) score += 1;
      return score;
    }
    // 插件 tab 的搜索/分类/信号过滤（在完整数组 filter 后重新分页）。
    // opts.verifiedOnly=仅已验证徽章；opts.hideArchived=隐藏归档仓库。
    function filterRepos(repos, query, category, opts) {
      var q = (query || "").trim().toLowerCase();
      var verifiedOnly = !!(opts && opts.verifiedOnly);
      var hideArchived = !!(opts && opts.hideArchived);
      return repos.filter(function (r) {
        if (category !== "all" && (r.category || "other") !== category) return false;
        if (verifiedOnly && !isVerifiedRepo(r)) return false;
        if (hideArchived && r.archived === true) return false;
        if (!q) return true;
        return repoMatchScore(r, q) > 0;
      });
    }
    // S1 信号面：已验证徽章判定（market_tags 含 verified-install）。
    function isVerifiedRepo(r) {
      return !!(r && Array.isArray(r.market_tags) && r.market_tags.indexOf("verified-install") !== -1);
    }
    // S1 信号面：列表比较器（镜像 lib/domain/list.js 语义，ES5 无依赖）。
    // stars 默认 / trending=stars_delta_7d 降序（null 未知垫底，同值回退 stars）/
    // updated=updated_at 降序 / name=full_name 升序。未知键回退 stars。
    function repoComparator(sortKey) {
      var key = (sortKey === "trending" || sortKey === "updated" || sortKey === "name") ? sortKey : "stars";
      function starsOf(r) { return Number.isFinite(r && r.stargazers_count) ? r.stargazers_count : 0; }
      if (key === "trending") {
        return function (a, b) {
          var da = Number.isFinite(a && a.stars_delta_7d) ? a.stars_delta_7d : -Infinity;
          var db = Number.isFinite(b && b.stars_delta_7d) ? b.stars_delta_7d : -Infinity;
          if (da !== db) return db - da;
          return starsOf(b) - starsOf(a);
        };
      }
      if (key === "updated") {
        return function (a, b) {
          var ta = Date.parse((a && a.updated_at) || "") || 0;
          var tb = Date.parse((b && b.updated_at) || "") || 0;
          if (ta !== tb) return tb - ta;
          return starsOf(b) - starsOf(a);
        };
      }
      if (key === "name") {
        return function (a, b) {
          return String((a && a.full_name) || "").localeCompare(String((b && b.full_name) || ""));
        };
      }
      return function (a, b) { return starsOf(b) - starsOf(a); };
    }
    // Skills 分页追加：第 1 页直接替换；后续页按 full_name 去重后拼接（跨页去重）。
    function appendSkillsPage(prev, pg, dataRepos) {
      if (pg === 1) return dataRepos || [];
      var seen = {};
      (prev || []).forEach(function (r) { seen[r.full_name] = true; });
      return (prev || []).concat((dataRepos || []).filter(function (r) { if (seen[r.full_name]) return false; seen[r.full_name] = true; return true; }));
    }
    // Skills 触底加载门控：未加载完且不在加载中才请求下一页。
    function shouldLoadMore(repos, total, loading) {
      return Boolean(!loading && repos && repos.length < total);
    }
    // 反馈偏好三态（v2）：合法 mode 值（"ask" 默认 / "ask-failed" / "off"）直用；
    // 否则回退旧开关值 dshm.fb.enabled（"0"→"off"，其余→"ask"）。
    // migrated=true 表示结论来自旧 key——调用方应把新值写回 dshm.fb.mode 并删除旧 key。
    function resolveFbMode(modeValue, enabledValue) {
      if (modeValue === "ask" || modeValue === "ask-failed" || modeValue === "off") {
        return { mode: modeValue, migrated: false };
      }
      if (enabledValue !== null && enabledValue !== undefined) {
        return { mode: enabledValue === "0" ? "off" : "ask", migrated: true };
      }
      return { mode: "ask", migrated: false };
    }
