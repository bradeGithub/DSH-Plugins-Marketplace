            h("input", { type: "checkbox", checked: verifiedOnly, onChange: function () { setVerifiedOnly(!verifiedOnly); }, style: { accentColor: "var(--dsw-alias-brand-primary)", cursor: "pointer", margin: 0 } }),
            t("filterVerified")
          ),
          h("label", { style: { display: "flex", alignItems: "center", gap: 4, fontSize: 12, color: "var(--dsw-alias-label-secondary)", cursor: "pointer" } },
            h("input", { type: "checkbox", checked: hideArchived, onChange: function () { setHideArchived(!hideArchived); }, style: { accentColor: "var(--dsw-alias-brand-primary)", cursor: "pointer", margin: 0 } }),
            t("filterHideArchived")
          )
        ),
        h("div", { style: { display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 12 } },
          ["all"].concat(CATEGORY_KEYS).map(function (key) {
