        if (!el) return;
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting && shouldLoadMore(repos, total, loading)) {
              fetchPage(page + 1, query, false, sort, verifiedOnly, hideArchived);
