        }),
        h("div", { style: { display: "flex", flexWrap: "wrap", gap: 8, alignItems: "center", marginBottom: 8 } },
          h("span", { style: { fontSize: 12, color: "var(--dsw-alias-label-tertiary)" } }, t("sortLabel")),
          h("select", {
            style: Object.assign({}, s.input, { width: "auto", marginTop: 0, padding: "4px 8px", fontSize: 12 }),
            value: sort,
            onChange: function (e) { setSort(e.target.value); }
