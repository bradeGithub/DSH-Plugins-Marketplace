#!/bin/sh
# Git Hook: commit-msg —— 校验提交信息符合仓库规范（<type>(<scope>): <描述>）
# 由 scripts/install-hooks.sh 安装，git 会传入提交信息文件路径作为 $1。
# hook 位于共享 .git/hooks/，不能用 $0 上溯（linked worktree 下会解析到主仓）。
# git 保证 hook 的 cwd = 当前工作树顶，rev-parse 取其绝对路径。
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/hooks/check.mjs" --stage=commit-msg "$1"
